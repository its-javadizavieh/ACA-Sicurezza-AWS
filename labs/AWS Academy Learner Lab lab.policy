{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAllActions1",
      "Effect": "Allow",
      "Action": [
        "acm:*",
        "acm-pca:ListCertificateAuthorities",
        "amplify:*",
        "amplifybackend:*",
        "apigateway:*",
        "application-autoscaling:*",
        "appmesh:*",
        "arsenal:RegisterOnPremisesAgent",
        "artifact:*",
        "athena:*",
        "autoscaling:*",
        "aws-marketplace:ViewSubscriptions",
        "backup:*",
        "backup-storage:*",
        "batch:*",
        "ce:*",
        "cloud9:*",
        "cloudformation:*",
        "cloudshell:*",
        "cloudtrail:*",
        "cloudwatch:*",
        "codecommit:*",
        "codedeploy:*",
        "codepipeline:*",
        "codestar-notifications:*",
        "codewhisperer:GenerateRecommendations",
        "cognito-identity:*",
        "cognito-idp:*",
        "cognito-sync:*",
        "compute-optimizer:GetEnrollmentStatus",
        "config:*",
        "cur:*",
        "databrew:*",
        "deepcomposer:*",
        "deeplens:*",
        "deepracer:*",
        "dms:*",
        "ds:*",
        "dynamodb:*",
        "ebs:*",
        "ec2:*",
        "ec2messages:*",
        "ec2-instance-connect:Send*",
        "ecr:*",
        "ecs:*",
        "eks:*",
        "elasticbeanstalk:*",
        "elasticache:*",
        "elasticfilesystem:*",
        "elasticloadbalancing:*",
        "elasticmapreduce:*",
        "emr-containers:*",
        "events:*",
        "execute-api:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-west-2"
          ]
        }
      }
    },
    {

      "Effect": "Allow",
      
      "Action": "ec2:CreateVolume",
      
      "Resource": "arn:aws:ec2:*::snapshot/*"
      
    },                         
    {
      "Sid": "AllowAllActions2",
      "Effect": "Allow",
      "Action": [
        "firehose:*",
        "glacier:*",
        "glue:*",
        "greengrass:*",
        "groundtruthlabeling:*",
        "guardduty:*",
        "health:*",
        "inspector:*",
        "iot1click:*",
        "iot:*",
        "iotevents:*",
        "kinesis:*",
        "kinesisanalytics:*",
        "kms:*",
        "lambda:*",
        "logs:*",
        "machinelearning:*",
        "mobilehub:*",
        "opsworks:*",
        "pipes:*Pipe*",
        "pipes:*Resource",
        "q:ListConversations",
        "q:GetConversation",
        "q:GetTroubleshootingResults",
        "q:SendMessage",
        "q:StartConversation",
        "q:StartTroubleshootingAnalysis",
        "q:StartTroubleshootingResolutionExplanation",
        "rds:*ActivityStream",
        "rds:*Backup*",
        "rds:*Cluster",
        "rds:*DBProxy*",
        "rds:*Event*",
        "rds:*Export*",
        "rds:*Group*",
        "rds:*MaintenanceAction",
        "rds:*Region*",
        "rds:*Snapshot*",
        "rds:*Tag*",
        "rds:Add*",
        "rds:CreateCustomDBEngineVersion",
        "rds:CreateDBClusterEndpoint",
        "rds:Delete*",
        "rds:Describe*",
        "rds:Download*",
        "rds:ModifyCertificates",
        "rds:ModifyCustomDBEngineVersion",
        "rds:ModifyDBClusterEndpoint",
        "rds:ModifyRecommendation",
        "rds:Promote*",
        "rds:Reboot*",
        "rds:Remove*",
        "rds:Restore*",
        "rds:StopDB*",
        "rds-data:*",
        "redshift:*",
        "redshift-data:*",
        "redshift-serverless:List*",
        "rekognition:*",
        "resource-groups:*",
        "route53:*",
        "s3:*",
        "sagemaker:*",
        "scheduler:*",
        "secretsmanager:*",
        "securityhub:*",
        "serverlessrepo:*",
        "servicecatalog:*",
        "servicediscovery:ListNamespaces",
        "servicequotas:List*",
        "sns:*",
        "sqlworkbench:*",
        "sqs:*",
        "ssm:*",
        "ssmmessages:*",
        "states:*",
        "sts:AssumeRole",
        "sts:Get*",
        "swf:*",
        "tag:*",
        "textract:*",
        "trustedadvisor:*",
        "waf:*",
        "waf-regional:*",
        "wafv2:*",
        "wellarchitected:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "IamAllowPassLabRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/LabRole",
        "arn:aws:iam::*:role/LabInstanceProfile",
        "arn:aws:iam::*:role/aws-service-role/*.amazonaws.com/*",
        "arn:aws:iam::*:role/EMR_DefaultRole",
        "arn:aws:iam::*:role/EMR_DefaultRole_V2",
        "arn:aws:iam::*:role/EMR_EC2_DefaultRole",
        "arn:aws:iam::*:role/EMR_AutoScaling_DefaultRole",
        "arn:aws:iam::*:role/myRedshiftRole"
      ],
      "Condition": {
        "StringLike": {
          "iam:PassedToService": [
            "*.amazonaws.com"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::*:role/EMR_Notebooks_DefaultRole",
        "arn:aws:iam::*:role/LabRole",
        "arn:aws:iam::*:role/*LabEksClusterRole-*",
        "arn:aws:iam::*:role/*LabEksNodeRole-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/aws-service-role/*.amazonaws.com/*"
    },
    {
      "Sid": "IamAllowServiceLinkedRoleCreation",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*"
    },
    {
      "Sid": "IamLimited",
      "Effect": "Allow",
      "Action": [
        "iam:AddRoleToInstanceProfile",
        "iam:CreateInstanceProfile",
        "iam:CreatePolicy",
        "iam:DeleteInstanceProfile",
        "iam:DeletePolicy",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DeleteServiceLinkedRole",
        "iam:Get*",
        "iam:List*",
        "iam:*LoginProfile",
        "iam:Remove*",
        "iam:Sim*",
        "iam:UpdateRoleDescription",
        "iam:UploadServerCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamNoView",
      "Effect": "Deny",
      "Action": [
        "iam:Delete*",
        "iam:Update*"
      ],
      "Resource": [
        "arn:aws:iam::*:policy/*VocLabPolicy*",
        "arn:aws:iam::*:role/LabRole",
        "arn:aws:iam::*:role/myRedshiftRole",
        "arn:aws:iam::*:role/RedshiftRole",
        "arn:aws:iam::*:role/LambdaSLRRole",
        "arn:aws:iam::*:role/RoleForLambdaModLabRole"
      ]
    },
    {
      "Sid": "PermsAndMonitoringNoView",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:events:*:*:rule/*MonitoringRule*",
        "arn:aws:events:*:*:rule/resourceFunctionRule",
        "arn:aws:iam::*:policy/*VocLabPolicy*",
        "arn:aws:iam::*:role/RoleForLambdaModLabRole",
        "arn:aws:lambda:*:*:function:*MonitoringFunction*",
        "arn:aws:lambda:*:*:function:RedshiftOverwatch",
        "arn:aws:lambda:*:*:function:RedshiftEventSubscription",
        "arn:aws:lambda:*:*:function:RoleCreationFunction",
        "arn:aws:lambda:*:*:function:ModLabRole",
        "arn:aws:logs:*:*:log-group:/aws/lambda/*MonitoringFunction:*",
        "arn:aws:sns:*:*:RedshiftSNS"
      ]
    },
    {
      "Sid": "AllServicesDenyNoConds",
      "Effect": "Deny",
      "Action": [
        "codebuild:Update*",
        "codebuild:Create*",
        "codebuild:Batch*",
        "dynamodb:*Reserved*",
        "ec2:*Fpga*",
        "ec2:*Spot*",
        "ec2:*ReservedInstances*",
        "ec2:*Scheduled*",
        "ec2:*Purchase*",
        "ec2:CreateFleet",
        "ec2:EnableFastSnapshotRestores",
        "glacier:*VaultLock",
        "rds:Purchase*",
        "redshift:AcceptReservedNodeExchange",
        "redshift:PurchaseReservedNodeOffering",
        "route53domains:RegisterDomain",
        "s3:*ObjectLegalHold",
        "s3:*ObjectRetention",
        "s3:PutBucketObjectLockConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AsgRestrict",
      "Action": [
        "autoscaling:CreateLaunchConfiguration"
      ],
      "Effect": "Deny",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringNotLike": {
          "autoscaling:InstanceType": [
            "*.nano",
            "*.micro",
            "*.small",
            "*.medium",
            "*.large"
          ]
        }
      }
    },
    {
      "Sid": "Cloud9Restrict",
      "Effect": "Deny",
      "Action": [
        "cloud9:UpdateEnvironment*",
        "cloud9:CreateEnvironment*"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringNotLikeIfExists": {
          "cloud9:InstanceType": [
            "*.nano",
            "*.micro",
            "*.small",
            "*.medium",
            "*.large",
            "c4.xlarge"
          ]
        }
      }
    },
    {
      "Sid": "ec2NoSpot",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEqualsIfExists": {
          "ec2:InstanceMarketType": "spot"
        }
      }
    },
    {
      "Sid": "Ec2RestrictPlacementGroup",
      "Action": "ec2:*Instance*",
      "Effect": "Deny",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:PlacementGroupStrategy": "cluster"
        }
      }
    },
    {
      "Sid": "Ec2DenyTenancy",
      "Action": "ec2:*Instance*",
      "Effect": "Deny",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotLike": {
          "ec2:Tenancy": "default"
        }
      }
    },
    {
      "Sid": "Ec2RestrictInstanceTypes",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "ForAnyValue:StringNotLike": {
          "ec2:InstanceType": [
            "*.nano",
            "*.micro",
            "*.small",
            "*.medium",
            "*.large"
          ]
        }
      }
    },
    {
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": ["us-east-1", "us-west-2"]
        }
      }
    },    
    {
      "Sid": "Ec2RestrictLargeVolumes",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": {
        "NumericGreaterThanIfExists": {
          "ec2:VolumeSize": "101"
        }
      }
    },
    {
      "Sid": "Ec2RestrictPIOPSVolumes",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume"
      ],
      "Effect": "Deny",
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": {
        "StringNotLikeIfExists": {
          "ec2:VolumeType": [
            "gp2",
            "gp3",
            "sc1",
            "standard"
          ]
        }
      }
    },
    {
      "Sid": "RdsRestrictPiops",
      "Action": [
        "rds:CreateDBInstance",
        "rds:CreateDBInstanceReadReplica",
        "rds:CreateGlobalCluster",
        "rds:StartDB*",
        "rds:ModifyDBCluster",
        "rds:ModifyCurrentDBClusterCapacity",
        "rds:ModifyDBInstance",
        "rds:ModifyGlobalCluster",
        "rds:RestoreDB*",
        "rds:RebootDBInstance"
      ],
      "Effect": "Deny",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:NumericGreaterThanIfExists": {
          "rds:Piops": "100",
          "rds:StorageSize": "101"
        }
      }
    },
    {
      "Sid": "RdsAllowAllAsLongAs",
      "Action": [
        "rds:*"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringLikeIfExists": {
          "rds:DatabaseClass": [
            "*.nano",
            "*.small",
            "*.micro",
            "*.medium"
          ],
          "rds:DatabaseEngine": [
            "aurora-mysql",
            "aurora-postgresql",
            "mysql",
            "postgres",
            "mariadb",
            "oracle-*",
            "sqlserver-*"
          ],
          "aws:RequestedRegion": [
            "us-east-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "DenyCreateOrModifyAuroraDenyserverlesscreation",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "rds:Databaseclass": "db.serverless"
        }
      }
    },
    {
      "Sid": "smAllowSpecificModelTraining",
      "Effect": "Deny",
      "Action": [
        "sagemaker:CreateApp",
        "sagemaker:CreateEndpointConfig",
        "sagemaker:CreateExperiment",
        "sagemaker:CreateHyperParameterTuningJob",
        "sagemaker:CreateModel",
        "sagemaker:CreateNotebookInstance",
        "sagemaker:CreateProcessingJob",
        "sagemaker:CreateTrainingJob",
        "sagemaker:CreateTransformJob",
        "sagemaker:UpdateNotebookInstance",
        "sagemaker:UpdateTrainingJob"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringNotLike": {
          "sagemaker:InstanceTypes": [
            "ml.t3.medium",
            "ml.t3.large",
            "ml.t3.xlarge",
            "ml.m5.large",
            "ml.m5.xlarge",
            "ml.c5.large",
            "ml.c5.xlarge"
          ]
        }
      }
    }
  ]
}
